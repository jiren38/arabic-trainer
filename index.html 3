const CHEST_TYPES = {
  common: { name: "Cassa di Legno", price: 80, class: "chest-wooden" },
  silver: { name: "Cassa d'Argento", price: 150, class: "chest-silver" },
  rare: { name: "Cassa d'Oro", price: 300, class: "chest-gold" },
