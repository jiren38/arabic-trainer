const Quests = {
  getTodayQuests() {
    const t = today();
    if (!St.d.quests) St.d.quests = { lastDate: "", list: [] };
    
    if (St.d.quests.lastDate !== t) {
      St.d.quests.lastDate = t;
      St.d.quests.list = [
        { id: "q1", desc: "Completa l'obiettivo di studio oggi", target: St.d.goal, type: "daily_q", reward: 60, done: false, claimed: false },
        { id: "q2", desc: "Rispondi correttamente a 10 domande", target: 10, type: "ok_ans", reward: 80, done: false, claimed: false },
        { id: "q3", desc: "Esercitati con la scrittura a mano 1 volta", target: 1, type: "hand_ex", reward: 100, done: false, claimed: false }
      ];
      St.save();
    }
    
    const y = St.d.days[t] || { q: 0 };
    St.d.quests.list.forEach(q => {
      if (q.id === "q1" && y.q >= q.target) q.done = true;
      if (q.id === "q2" && St.d.ok >= q.target) q.done = true;
      if (q.id === "q3" && (St.d.mode["hand"] || [0,0])[0] >= 1) q.done = true;
    });
    
    return St.d.quests.list;
  },

  claim(id) {
    const q = St.d.quests.list.find(x => x.id === id);
    if (q && q.done && !q.claimed) {
      q.claimed = true;
      St.d.coins = (St.d.coins || 0) + q.reward;
      St.save();
      if (window.saveCloudProgress) window.saveCloudProgress();
      toast("🎉 + " + q.reward + " Monete riscattate!");
      render();
    }
  },

  buyChest(type) {
    const chestInfo = CHEST_TYPES[type];
    if (!chestInfo) return;
    if ((St.d.coins || 0) < chestInfo.price) {
      toast("⚠️ Monete insufficienti!");
      return;
    }
    St.d.coins -= chestInfo.price;
    if (!St.d.chests) St.d.chests = {};
    St.d.chests[type] = (St.d.chests[type] || 0) + 1;
    St.save();
    if (window.saveCloudProgress) window.saveCloudProgress();
    toast("📦 " + chestInfo.name + " acquistata!");
    render();
  }
};

