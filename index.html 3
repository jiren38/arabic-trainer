    };
  },

  getTotalPointsCount() { return this.strokes.reduce((acc, s) => acc + s.length, 0) + this.currentStroke.length; },

  clear() {
    this.stopAnim(); const c = $("hw_cv"); if (c && this.ctx) this.ctx.clearRect(0, 0, c.width, c.height);
    this.strokes = []; this.currentStroke = []; const g = $("hw_ghost"); if (this.guided && g) g.classList.remove("fade-out");
    const res = $("hw_result"); if (res) res.innerHTML = "";
  },

  stopAnim() { 
    if (this.animTimer) { 
      cancelAnimationFrame(this.animTimer); 
      this.animTimer = null; 
    } 
  },

  playDemo() {
    this.clear();
    const l = L[this.curIdx], c = $("hw_cv");
    if (!c) return;
    const rect = c.getBoundingClientRect(), w = rect.width, h = rect.height;
    
    const tempCanvas = document.createElement("canvas");
    tempCanvas.width = w * (window.devicePixelRatio || 1);
    tempCanvas.height = h * (window.devicePixelRatio || 1);
    const tCtx = tempCanvas.getContext("2d");
    tCtx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);
    
    tCtx.font = `${h * 0.55}px "Amiri", "Noto Naskh Arabic", serif`;
    tCtx.textAlign = "center";
    tCtx.textBaseline = "middle";
    tCtx.fillStyle = "#ffffff"; 
    tCtx.fillText(l[0], w / 2, h / 2);

    let progress = 0;
    const animateLoop = () => {
      progress += 0.02;

      this.ctx.clearRect(0, 0, w, h);
      
      if (progress <= 1) {
        this.ctx.save();
        this.ctx.beginPath();
        const currentX = w - w * Math.min(1, progress);
        this.ctx.rect(currentX, 0, w, h);
        this.ctx.clip();
        this.ctx.drawImage(tempCanvas, 0, 0, w, h);
        this.ctx.restore();
        this.drawStrokeIndicators(w, h, progress);
        this.animTimer = requestAnimationFrame(animateLoop);
      } else {
        // Fine animazione: si pulisce e si sblocca la scrittura
        this.stopAnim();
        setTimeout(() => this.clear(), 800);
      }
    };

    this.stopAnim();
    animateLoop();
  },

  drawStrokeIndicators(w, h, progress) {
    this.ctx.save();
    this.ctx.fillStyle = "#e74c3c";
    this.ctx.strokeStyle = "#e74c3c";
    this.ctx.lineWidth = 2;
    this.ctx.font = "bold 14px system-ui";

    const startX = w * 0.7, startY = h * 0.35;
    this.ctx.beginPath();
    this.ctx.arc(startX, startY, 10, 0, Math.PI * 2);
    this.ctx.fillStyle = "#e74c3c";
    this.ctx.fill();
    this.ctx.fillStyle = "#ffffff";
    this.ctx.textAlign = "center";
    this.ctx.textBaseline = "middle";
    this.ctx.fillText("1", startX, startY);

    this.ctx.beginPath();
    this.ctx.setLineDash([3, 3]);
    this.ctx.moveTo(startX - 12, startY);
    this.ctx.lineTo(startX - 45, startY + 15);
    this.ctx.stroke();

    this.ctx.restore();
  },

  evaluate() {
    const resEl = $("hw_result"); 
    if (this.strokes.length === 0) { 
      if (typeof Au !== "undefined" && Au.note) Au.note("Disegna la lettera prima di verificare!"); 
      return; 
    }

    const targetChar = L[this.curIdx][0]; 
    let maxAllowedStrokes = ["ب", "ت", "ث", "ك", "ي", "ط", "ظ", "ن"].includes(targetChar) ? 4 : 2;
    
    if (this.strokes.length > maxAllowedStrokes) { 
      if (resEl) resEl.innerHTML = `<div class="accuracy-badge err-red">🔴 Sbagliata (Troppi tratti isolati)</div>`; 
      if (typeof St !== "undefined" && St.log) St.log([this.curIdx], "write", false, "hand", 10000); 
      return; 
    }

    let allPoints = []; 
    this.strokes.forEach(s => allPoints.push(...s));
    if (allPoints.length < 8) { 
      if (resEl) resEl.innerHTML = `<div class="accuracy-badge err-red">🔴 Tratto troppo breve o incompleto</div>`; 
      return; 
    }

    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    allPoints.forEach(p => { 
      if (p.x < minX) minX = p.x; 
      if (p.x > maxX) maxX = p.x; 
      if (p.y < minY) minY = p.y; 
      if (p.y > maxY) maxY = p.y; 
    });

    const userW = maxX - minX, userH = maxY - minY, aspectRatio = userW / (userH || 1); 
    let score = 100, errorMsg = "";

    if (targetChar === "ا" || targetChar === "أ" || targetChar === "إ") { 
      if (aspectRatio > 0.55 || userH < 35) { score = 0; errorMsg = "Sviluppo errato: la Alif deve essere un tratto verticale!"; } 
    } else if (["ب", "ت", "ث"].includes(targetChar)) { 
      if (aspectRatio < 0.75) { score = 0; errorMsg = "Sviluppo errato: questa lettera va scritta in orizzontale!"; } 
    }

    if (score > 0) {
      const cv = $("hw_cv"), w = cv.width, h = cv.height;
      const userImg = this.ctx.getImageData(0, 0, w, h).data;
      const guideImg = this.guideCtx.getImageData(0, 0, w, h).data;
      
      let guidePixels = 0, hitPixels = 0, outPixels = 0;
      for (let y = 0; y < h; y += 4) { 
        for (let x = 0; x < w; x += 4) { 
          const idx = (y * w + x) * 4; 
          if (guideImg[idx + 3] > 50) guidePixels++; 
          if (userImg[idx + 3] > 50) { 
            if (guideImg[idx + 3] > 50) hitPixels++; 
            else outPixels++; 
          } 
        } 
      } 
      
      const matchPercent = guidePixels > 0 ? (hitPixels / guidePixels) * 100 : 0;
      const penalty = hitPixels > 0 ? (outPixels / hitPixels) * 40 : 0;
      score = Math.max(0, Math.round(matchPercent * 2.2 - penalty)); 
      score = Math.min(100, score);
    }

    const isGood = score >= 60; 
    if (typeof St !== "undefined" && St.log) St.log([this.curIdx], "write", isGood, "hand", 10000);

    if (resEl) {
      if (score >= 70) { 
        resEl.innerHTML = `<div class="accuracy-badge ok-green">🟢 Corretta! (${score}%)</div>`; 
        if (typeof say === "function") say(AN[this.curIdx]); 
      } else if (score >= 40) { 
        resEl.innerHTML = `<div class="accuracy-badge warn-yellow">🟡 Inaccurata (${score}%). ${errorMsg || "Segui meglio la traccia guida."}</div>`; 
      } else { 
        resEl.innerHTML = `<div class="accuracy-badge err-red">🔴 Errata (${score}%). ${errorMsg || "Forma o proporzioni non valide."}</div>`; 
      }
    }
  }
};

