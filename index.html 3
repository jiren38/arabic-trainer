/* ===== Sistema Effetti Sonori della Cassa (Senza Voce) ===== */
const ChestAudio = {
  ctx: null,
  init() {
    if (!this.ctx) {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (AudioCtx) this.ctx = new AudioCtx();
    }
    if (this.ctx && this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  },
  // Suono del rullo che gira (Tick meccanico)
  playTick() {
    if (!St.d.au) return;
    this.init();
    if (!this.ctx) return;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.type = "sine";
    osc.frequency.setValueAtTime(600, this.ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(120, this.ctx.currentTime + 0.04);
    gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.04);
    osc.connect(gain);
    gain.connect(this.ctx.destination);
    osc.start();
    osc.stop(this.ctx.currentTime + 0.04);
  },
  // Suono di ottenimento premio (Fanfara)
  playWin() {
    if (!St.d.au) return;
    this.init();
    if (!this.ctx) return;
    const notes = [261.63, 329.63, 392.00, 523.25]; // Do, Mi, Sol, Do
    notes.forEach((freq, index) => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(freq, this.ctx.currentTime + index * 0.1);
      gain.gain.setValueAtTime(0.2, this.ctx.currentTime + index * 0.1);
      gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + index * 0.1 + 0.3);
      osc.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(this.ctx.currentTime + index * 0.1);
      osc.stop(this.ctx.currentTime + index * 0.1 + 0.3);
    });
  }
};

let chestOpeningState = { spinning: false, wonItem: null, trackItems: [], targetOffset: 0 };

function startChestOpening(type) {
  if (!St.d.chests) St.d.chests = {};
  if ((St.d.chests[type] || 0) <= 0) {
    toast("⚠️ Non possiedi questa cassa!");
    return;
  }

  St.d.chests[type]--;
  St.save();
  if (window.saveCloudProgress) window.saveCloudProgress();

  // Genera la sequenza fissa per la roulette
  let trackItems = [];
  for (let i = 0; i < 35; i++) {
    trackItems.push(pick(LOOT_ITEMS));
  }

  const rand = Math.random() * 100;
  let won;
  if (type === "legendary") {
    won = rand < 30 ? pick(LOOT_ITEMS.filter(x => x.rarity === "mythic")) : pick(LOOT_ITEMS.filter(x => x.rarity === "legendary"));
  } else if (type === "magical") {
    won = rand < 50 ? pick(LOOT_ITEMS.filter(x => x.rarity === "legendary")) : pick(LOOT_ITEMS.filter(x => x.rarity === "epic"));
  } else if (type === "rare") {
    won = rand < 40 ? pick(LOOT_ITEMS.filter(x => x.rarity === "epic")) : pick(LOOT_ITEMS.filter(x => x.rarity === "rare"));
  } else if (type === "silver") {
    won = rand < 30 ? pick(LOOT_ITEMS.filter(x => x.rarity === "rare")) : pick(LOOT_ITEMS.filter(x => x.rarity === "uncommon"));
  } else {
    won = rand < 20 ? pick(LOOT_ITEMS.filter(x => x.rarity === "uncommon")) : pick(LOOT_ITEMS.filter(x => x.rarity === "common"));
  }
  if (!won) won = LOOT_ITEMS[0];
  
  const targetIndex = 26;
  trackItems[targetIndex] = won;

  chestOpeningState = { spinning: true, wonItem: won, trackItems: trackItems, targetOffset: 0 };
  go("chest_open");

  setTimeout(() => {
    const track = $("roulette_track");
    const container = document.querySelector(".roulette-container");
    if (!track || !container) return;

    const itemWidth = 90;
    const containerWidth = container.offsetWidth;
    const offset = (targetIndex * itemWidth) + (itemWidth / 2) - (containerWidth / 2);
    chestOpeningState.targetOffset = offset;

    track.style.transition = "none";
    track.style.transform = "translateX(0px)";

    setTimeout(() => {
      track.style.transition = "transform 4.5s cubic-bezier(0.15, 0.9, 0.15, 1)";
      track.style.transform = `translateX(-${offset}px)`;

      // Riproduce il suono del rullo che gira
      let tickCount = 0;
      const totalTicks = 22;
      const playNextTick = () => {
        if (tickCount < totalTicks && chestOpeningState.spinning) {
          ChestAudio.playTick();
          tickCount++;
          const delay = 80 + Math.pow(tickCount, 2) * 6;
          setTimeout(playNextTick, delay);
        }
      };
      playNextTick();
    }, 50);

    // Al termine: blocca le icone senza farle scambiare e suona la fanfara
    setTimeout(() => {
      chestOpeningState.spinning = false;
      applyReward(won);
      ChestAudio.playWin();
      
      const winBox = $("chest_win_box");
      const statusText = $("chest_status_text");
      if (statusText) statusText.textContent = "🎉 Complimenti! Ecco il tuo premio:";
      if (winBox) {
        winBox.innerHTML = `
          <div style="font-size:3.5rem; animation: pulse 0.5s;">${won.icon}</div>
          <h3 style="font-size:1.4rem; margin:8px 0; color:var(--ac);">${won.name}</h3>
          <p class="sub">Rarità: <b style="text-transform:capitalize;">${won.rarity}</b></p>
          <button class="btn p" style="margin-top:12px; padding:12px 24px;" onclick="go('shop')">Torna allo Shop</button>
        `;
      }
    }, 4600);
  }, 100);
}

function applyReward(item) {
  if (item.type === "coins") {
    St.d.coins = (St.d.coins || 0) + item.val;
  } else {
    if (!St.d.inventory) St.d.inventory = [];
    if (!St.d.inventory.includes(item.name)) St.d.inventory.push(item.name);
  }
  St.save();
  if (window.saveCloudProgress) window.saveCloudProgress();
  // Rimosso del tutto l'effetto vocale in arabo
}

