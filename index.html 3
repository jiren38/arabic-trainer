        const mergedCoins = Math.max(St.d.coins || 0, cloudData.coins || 0);
        const mergedChests = {
          common: Math.max((St.d.chests || {}).common || 0, (cloudData.chests || {}).common || 0),
          rare: Math.max((St.d.chests || {}).rare || 0, (cloudData.chests || {}).rare || 0),
          legendary: Math.max((St.d.chests || {}).legendary || 0, (cloudData.chests || {}).legendary || 0)
        };
        const mergedInventory = Array.from(new Set([...(St.d.inventory || []), ...(cloudData.inventory || [])]));

        St.d = Object.assign({}, St.d, cloudData, {
          vocab: Array.from(mergedVocabMap.values()),
          flashcardSets: Array.from(setMap.values()),
          flashcardSetDeletedIds: deletedSetIds,
          flashcardStats: mergedFlashcardStats,
          placement: mergedPlacement,
          lessonSessions: mergedLessonSessions,
          coins: mergedCoins,
          chests: mergedChests,
          inventory: mergedInventory,
          ok: Math.max(St.d.ok || 0, cloudData.ok || 0),
          n: Math.max(St.d.n || 0, cloudData.n || 0),
          done: Math.max(St.d.done || 0, cloudData.done || 0),
          streak: Math.max(St.d.streak || 0, cloudData.streak || 0)
        });

        try { localStorage.setItem("at1", JSON.stringify(St.d)); } catch(e){}
        try { localStorage.setItem("at_vocab", JSON.stringify(St.d.vocab)); } catch(e){}
      }
      window.isCloudLoaded = true;
      await window.saveCloudProgress();
    } catch (e) {
      console.error("Errore nel caricamento dal Cloud:", e);
      window.isCloudLoaded = true;
    }
    if (typeof render === "function") render();
  }
</script>
