<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Arabic Trainer — allenamento interattivo per imparare l'alfabeto arabo, leggere, scrivere e ripassare.">
<meta name="theme-color" content="#2f3fb0">
<title>Arabic Trainer</title>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f5f9;--card:#fff;--tx:#17203a;--mu:#5d667e;--ac:#2f3fb0;--sel:#e4e8ff;--ok:#157a3d;--ko:#b3261e;--bd:#d9deea;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10131d;--card:#1a1f2e;--tx:#e8ebf5;--mu:#98a1ba;--ac:#8c9bff;--sel:#262d52;--ok:#5fd18a;--ko:#ff8a80;--bd:#2d3450}}
:root[data-theme="dark"]{--bg:#10131d;--card:#1a1f2e;--tx:#e8ebf5;--mu:#98a1ba;--ac:#8c9bff;--sel:#262d52;--ok:#5fd18a;--ko:#ff8a80;--bd:#2d3450}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
.ar{font-family:"Noto Naskh Arabic","Geeza Pro","Traditional Arabic","Arial",serif;direction:rtl;unicode-bidi:isolate}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--card);border-bottom:1px solid var(--bd)}
header div{max-width:860px;margin:0 auto;padding:8px 16px}
header b{font-size:1.15rem}
main{max-width:860px;margin:0 auto;padding:16px 16px 120px}
h2{font-size:1.25rem;margin:18px 0 6px}h3{font-size:1rem;margin:18px 0 8px}
p.sub,.sub{color:var(--mu);margin:0 0 12px}
button{font:inherit;cursor:pointer}
button:focus-visible,.card:focus-visible,input:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
.card{background:var(--card);border:2px solid var(--bd);border-radius:12px;padding:10px 8px;text-align:center;cursor:pointer;user-select:none;transition:transform .12s,border-color .12s}
.card:hover{border-color:var(--ac)}.card:active{transform:scale(.97)}
.card.on{border-color:var(--ac);background:var(--sel)}
.card .big{font-size:3rem;line-height:1.3}.card b{display:block}
.card small{color:var(--mu);display:block;font-size:.8rem;line-height:1.3}
.card .forms{font-size:1.25rem;display:flex;justify-content:center;gap:8px;margin-top:4px;direction:ltr}
.bar{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--bd);padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));z-index:5}
.bar div{max-width:860px;margin:0 auto;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.bar strong{flex:1 1 100%}
.btn{padding:10px 14px;border-radius:10px;border:1px solid var(--bd);background:var(--card);color:var(--tx);transition:transform .1s,background .15s}
.btn:hover{background:var(--sel)}.btn:active{transform:scale(.97)}
.btn.p{background:var(--ac);color:var(--bg);border-color:var(--ac);font-weight:600}
.btn.on{background:var(--sel);border-color:var(--ac);font-weight:600}
.btn:disabled{opacity:.5;cursor:default}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.mc{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.mc .card{text-align:left;padding:12px}
.panel{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:20px;text-align:center}
.word{font-size:4.2rem;line-height:1.6;min-height:1.6em}
.latin{font-size:2rem;font-weight:600;letter-spacing:.03em}
input[type=text]{width:100%;max-width:340px;padding:12px;font:inherit;font-size:1.2rem;border:2px solid var(--bd);border-radius:10px;background:var(--bg);color:var(--tx);text-align:center}
.fb{min-height:3em;margin:12px 0;font-size:1.05rem;text-align:left;max-width:520px;margin-left:auto;margin-right:auto}
.ok{color:var(--ok)}.ko{color:var(--ko)}
.row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:10px 0}
.key{min-width:52px;padding:6px 10px;font-size:1.8rem;border-radius:10px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);line-height:1.4}
.key:active{transform:scale(.95)}
.score{color:var(--mu);margin-bottom:8px}
.pb{height:8px;background:var(--bd);border-radius:4px;overflow:hidden;margin:6px 0 10px}.pb i{display:block;height:100%;background:var(--ac);transition:width .3s}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:10px}
.stat{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px}.stat small{display:block;color:var(--mu)}.stat b{font-size:1.15rem}
.lt{font-size:1.5rem;margin:0 2px}
.detail{display:flex;gap:16px;align-items:center;flex-wrap:wrap;background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin-top:14px}
.detail .big{font-size:4rem;line-height:1.2}
.fm{display:flex;gap:14px;font-size:1.6rem;direction:ltr}.fm span{text-align:center}.fm small{display:block;font-size:.75rem;color:var(--mu);font-family:system-ui}
.good{animation:pulse .5s}.bad{animation:shake .4s}
@keyframes pulse{50%{box-shadow:0 0 0 6px color-mix(in srgb,var(--ok) 35%,transparent)}}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
details{margin:18px 0;color:var(--mu);font-size:.92rem}details p{margin:6px 0}
button.card{color:var(--tx);font:inherit}.key.on{background:var(--sel)}.tst .keys,.tst .nt{display:none}.stat{text-align:left}.stat .lt{vertical-align:middle}body{background:radial-gradient(900px 420px at 100% -10%,color-mix(in srgb,var(--ac) 14%,transparent),transparent),var(--bg)}
:root{--sh:0 1px 2px rgba(20,30,70,.06),0 8px 22px rgba(20,30,70,.07)}
.card,.panel,.stat,.detail{box-shadow:var(--sh)}.card.on{box-shadow:0 0 0 3px color-mix(in srgb,var(--ac) 28%,transparent)}
.hero{position:relative;overflow:hidden;display:flex;gap:16px;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#2f3fb0,#0f8f86);color:#fff;border-radius:20px;padding:24px;box-shadow:var(--sh)}
.hero h2{margin:0 0 4px;font-size:1.6rem}.hero p{margin:4px 0 12px;opacity:.92}.hero>*{position:relative;z-index:1}
.hero .wm{position:absolute;right:-10px;bottom:-60px;font-size:12rem;line-height:1;opacity:.12;z-index:0;pointer-events:none}
.hb{background:#fff;color:#1f2a80;border-color:#fff;font-weight:700}.hb2{background:transparent;color:#fff;border-color:rgba(255,255,255,.6)}
.ring{width:96px;height:96px;flex:none}
#app>*{animation:fin .3s both}@keyframes fin{from{opacity:0;transform:translateY(8px)}}
.les{display:flex;gap:12px;align-items:center;justify-content:space-between;background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:12px 14px;margin-bottom:8px;box-shadow:var(--sh)}
.les.next{border-color:var(--ac)}.les b{display:block}.les small{color:var(--mu)}
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ac);color:var(--bg);padding:10px 16px;border-radius:12px;opacity:0;transition:opacity .3s;z-index:9;pointer-events:none;font-weight:600}

.hw-container { 
  position: relative; 
  width: min(100%, 300px); 
  aspect-ratio: 1; 
  margin: 16px auto; 
  background: #2a2f3d;
  border: 3px solid var(--bd); 
  border-radius: 16px; 
  box-shadow: 0 6px 16px rgba(0,0,0,0.08);
  overflow: hidden;
}
.hw-grid-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.25;
  z-index: 1;
}
.hw-canvas { 
  position: absolute; 
  inset: 0; 
  width: 100%; 
  height: 100%; 
  touch-action: none; 
  cursor: crosshair; 
  z-index: 3; 
}
.hw-guide { 
  position: absolute; 
  inset: 0; 
  display: grid; 
  place-items: center; 
  font-size: min(40vw, 170px); 
  color: var(--ac); 
  opacity: 0.2; 
  transition: opacity 0.4s ease; 
  z-index: 2; 
  pointer-events: none; 
}
.hw-guide.fade-out { opacity: 0 !important; }
.accuracy-badge { 
  font-weight: bold; 
  font-size: 1.1rem;
  padding: 10px 16px; 
  border-radius: 12px; 
  margin-top: 12px; 
  display: inline-block; 
}
.accuracy-badge.ok-green { background: rgba(39, 174, 96, 0.15); color: #27ae60; border: 1px solid #27ae60; }
.accuracy-badge.warn-yellow { background: rgba(243, 156, 18, 0.15); color: #d35400; border: 1px solid #f39c12; }
.accuracy-badge.err-red { background: rgba(231, 76, 60, 0.15); color: #c0392b; border: 1px solid #e74c3c; }

/* Stili Menu Laterale a comparsa */
body { padding-left: 0 !important; }
main { max-width: 1000px; margin: 0 auto; padding: 20px 16px 120px; }
.bar { left: 0 !important; }

#nav_overlay {
  position: fixed !important;
  inset: 0 !important;
  background: rgba(0, 0, 0, 0.5) !important;
  z-index: 9000 !important;
  display: none;
}
#nav_overlay.open { display: block !important; }

#nav {
  position: fixed !important;
  top: 0 !important;
  left: -280px !important;
  width: 270px !important;
  height: 100vh !important;
  background: var(--card) !important;
  border-right: 1px solid var(--bd) !important;
  display: flex !important;
  flex-direction: column !important;
  padding: 50px 14px 100px !important;
  gap: 6px !important;
  z-index: 9999 !important;
  transition: left 0.3s ease !important;
  box-shadow: 4px 0 20px rgba(0,0,0,0.25) !important;
  overflow-y: auto !important;
  -webkit-overflow-scrolling: touch;
}
#nav.open { left: 0 !important; }

#nav button {
  flex: none !important;
  width: 100% !important;
  text-align: left !important;
  padding: 10px 14px !important;
  font-size: 0.95rem !important;
  border-radius: 10px !important;
  white-space: nowrap !important;
  border: 0;
  background: none;
  color: var(--tx);
}
#nav button:hover { background: var(--sel); }
#nav button.on { background: var(--ac); color: var(--bg); font-weight: 600; }

.menu-toggle {
  background: none; border: none; font-size: 1.4rem;
  cursor: pointer; padding: 4px 8px; border-radius: 8px;
  color: var(--tx); margin-right: 12px; display: inline-flex; align-items: center;
}
.menu-toggle:hover { background: var(--sel); }
/* Stili 3D Casse Stile Clash Royale e Rarità */
.chest-3d-card {
  background: var(--card);
  border: 1px solid var(--bd);
  border-radius: 18px;
  padding: 16px;
  text-align: center;
  position: relative;
  box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  transition: transform 0.2s;
}
.chest-3d-card:hover { transform: translateY(-4px); }

/* Forma Cassa 3D */
.chest-3d {
  width: 90px;
  height: 80px;
  margin: 10px auto;
  position: relative;
  perspective: 600px;
}
.chest-body {
  width: 100%;
  height: 55px;
  position: absolute;
  bottom: 0;
  border-radius: 8px 8px 12px 12px;
  box-shadow: inset 0 -6px 0 rgba(0,0,0,0.3), inset 0 4px 0 rgba(255,255,255,0.2), 0 8px 15px rgba(0,0,0,0.4);
  border: 2px solid #222;
}
.chest-lid {
  width: 104%;
  height: 28px;
  position: absolute;
  top: 4px;
  left: -2%;
  border-radius: 12px 12px 4px 4px;
  box-shadow: inset 0 3px 0 rgba(255,255,255,0.3), 0 4px 6px rgba(0,0,0,0.3);
  border: 2px solid #222;
  z-index: 2;
}
.chest-lock {
  width: 18px;
  height: 22px;
  position: absolute;
  top: 22px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 4px;
  z-index: 3;
  box-shadow: 0 2px 5px rgba(0,0,0,0.5);
  border: 1px solid #111;
}

/* Temi Colore 3D per Tipo Cassa */
.chest-wooden .chest-body, .chest-wooden .chest-lid { background: linear-gradient(135deg, #8d5524, #5c3310); }
.chest-wooden .chest-lock { background: linear-gradient(135deg, #d4af37, #aa7c11); }

.chest-silver .chest-body, .chest-silver .chest-lid { background: linear-gradient(135deg, #bdc3c7, #7f8c8d); }
.chest-silver .chest-lock { background: linear-gradient(135deg, #e74c3c, #c0392b); }

.chest-gold .chest-body, .chest-gold .chest-lid { background: linear-gradient(135deg, #f1c40f, #b7950b); }
.chest-gold .chest-lock { background: linear-gradient(135deg, #3498db, #2980b9); }

.chest-magical .chest-body, .chest-magical .chest-lid { background: linear-gradient(135deg, #a569bd, #5b2c6f); }
.chest-magical .chest-lock { background: linear-gradient(135deg, #00f2fe, #4facfe); }

.chest-legendary .chest-body, .chest-legendary .chest-lid { background: linear-gradient(135deg, #ff0844, #ffb199); }
.chest-legendary .chest-lock { background: linear-gradient(135deg, #f1c40f, #fff); box-shadow: 0 0 10px #f1c40f; }

/* Rullo Apertura Cassa */
.roulette-container {
  position: relative;
  width: 100%;
  max-width: 380px;
  height: 110px;
  margin: 20px auto;
  overflow: hidden;
  border: 3px solid var(--ac);
  border-radius: 16px;
  background: #151824;
  box-shadow: 0 0 20px rgba(0,0,0,0.4);
}
.roulette-marker {
  position: absolute;
  top: 0; bottom: 0;
  left: 50%; transform: translateX(-50%);
  width: 4px;
  background: #f1c40f;
  z-index: 10;
  box-shadow: 0 0 10px #f1c40f;
}
.roulette-track {
  display: flex;
  align-items: center;
  position: absolute;
  top: 10px; left: 0;
  height: 90px;
  transition: transform 4.5s cubic-bezier(0.1, 1, 0.1, 1);
}
.roulette-item {
  width: 80px;
  height: 80px;
  margin: 0 5px;
  flex: none;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  background: rgba(255,255,255,0.08);
  border: 2px solid rgba(255,255,255,0.2);
  color: #fff;
  user-select: none;
}

/* Colori Rarità Oggetti */
.rarity-common { border-color: #b0bec5; background: rgba(176,190,197,0.2); }
.rarity-uncommon { border-color: #2ecc71; background: rgba(46,204,113,0.2); }
.rarity-rare { border-color: #3498db; background: rgba(52,152,219,0.2); }
.rarity-epic { border-color: #9b59b6; background: rgba(155,89,182,0.25); }
.rarity-legendary { border-color: #f1c40f; background: rgba(241,196,15,0.3); box-shadow: inset 0 0 15px rgba(241,196,15,0.5); }
.rarity-mythic { border-color: #ff0844; background: rgba(255,8,68,0.35); box-shadow: inset 0 0 20px rgba(255,8,68,0.6); }
  /* Styling Avatar Vettoriale / Manichino Modulare */
/* Studio Avatar Vettoriale Stile Duolingo */
.avatar-box {
  position: relative;
  width: 160px;
  height: 160px;
  margin: 0 auto 12px;
  border-radius: 50%;
  border: 4px solid var(--ac);
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sel);
}

.avatar-svg {
  display:block;
  width: 100%;
  height: 100%;
}
.avatar-mini{width:38px;height:38px;padding:0;flex:none;overflow:hidden;border:2px solid var(--ac);border-radius:50%;background:var(--sel);cursor:pointer;display:grid;place-items:center}
.avatar-mini .avatar-box{width:100%!important;height:100%!important;margin:0!important;border:0!important;border-radius:50%;box-shadow:none!important;overflow:hidden}
.avatar-mini .avatar-svg{width:100%;height:100%}

/* Slot accessori su SVG */
.acc-slot {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  pointer-events: none;
  line-height: 1;
}

.acc-hat { top: 12px; font-size: 3.2rem; z-index: 6; }
.acc-glasses { top: 48px; font-size: 2.2rem; z-index: 5; }
.acc-beard { top: 62px; font-size: 2.2rem; z-index: 4; }

/* Corpo / Busto dell'omino base */
.avatar-body-base {
  position: absolute;
  bottom: 0;
  width: 90px;
  height: 45px;
  background: #34495e;
  border-radius: 45px 45px 0 0;
  z-index: 2;
}

/* Testa dell'omino base */
.avatar-head-base {
  position: absolute;
  top: 25px;
  width: 60px;
  height: 65px;
  background: #f1c27d;
  border-radius: 30px;
  z-index: 3;
  box-shadow: inset 0 -4px 0 rgba(0,0,0,0.1);
}

/* Occhi base (se non ci sono occhiali o maschere) */
.avatar-eyes-default {
  position: absolute;
  top: 48px;
  width: 60px;
  display: flex;
  justify-content: space-around;
  padding: 0 14px;
  z-index: 4;
}
.avatar-eyes-default::before, .avatar-eyes-default::after {
  content: '';
  width: 6px;
  height: 6px;
  background: #2c3e50;
  border-radius: 50%;
}

/* Bocca base */
.avatar-mouth-default {
  position: absolute;
  top: 66px;
  left: 50%;
  transform: translateX(-50%);
  width: 14px;
  height: 7px;
  border-bottom: 2px solid #c0392b;
  border-radius: 0 0 10px 10px;
  z-index: 4;
}

/* Layer Accessori Posizionati */
.layer-bg { position: absolute; inset: 0; z-index: 1; }
.layer-outfit { position: absolute; bottom: 0; font-size: 3rem; z-index: 3; line-height: 1; }
.layer-facial { position: absolute; top: 56px; font-size: 2rem; z-index: 5; line-height: 1; }
.layer-glasses { position: absolute; top: 40px; font-size: 2.2rem; z-index: 6; line-height: 1; }
.layer-head { position: absolute; top: 2px; font-size: 2.8rem; z-index: 7; line-height: 1; }
/* Percorso di apprendimento: tappe, unità e progressione */
:root{--ac:#397b52;--sel:#e5f4e9;--ok:#23834a;--bd:#d8e5da;--bg:#f5f8f3}
:root[data-theme="dark"]{--ac:#74c98c;--sel:#203a2a;--ok:#74c98c;--bd:#34443a;--bg:#121a15}
.hero{background:linear-gradient(135deg,#267348,#45a76b 62%,#f0bd55);border-radius:24px;padding:26px;min-height:180px}
.hero h2{font-size:1.85rem;line-height:1.2}.btn.p{box-shadow:0 3px 0 color-mix(in srgb,var(--ac) 70%,#15281c);font-weight:750}.btn.p:active{transform:translateY(2px);box-shadow:none}
.path-wrap{position:relative;padding:8px 0 16px}.unit-card{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:18px;margin:16px 0;box-shadow:var(--sh)}
.unit-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.unit-head h3{margin:0}.unit-head small{color:var(--mu)}
.path-node{display:flex;align-items:center;gap:14px;max-width:460px;margin:18px auto;position:relative}.path-node:nth-child(even){flex-direction:row-reverse;text-align:right}.node-btn{width:68px;height:68px;border-radius:50%;border:0;background:#dce5df;color:#647368;font-size:1.65rem;box-shadow:0 5px 0 #b7c5ba;flex:none}.node-btn.ready{background:#55b978;color:white;box-shadow:0 5px 0 #348651}.node-btn.done{background:#f4c94c;color:#533f08;box-shadow:0 5px 0 #c79e27}.node-btn:disabled{cursor:not-allowed;opacity:.65}.node-copy{flex:1}.node-copy b,.node-copy small{display:block}.node-copy small{color:var(--mu)}.node-copy .btn{margin-top:6px}
.path-line{width:4px;height:18px;background:var(--bd);margin:-12px auto;border-radius:9px}.path-callout{background:linear-gradient(135deg,var(--sel),var(--card));border:1px solid var(--bd);border-radius:18px;padding:16px;margin:12px 0}
@media(max-width:560px){main{padding:14px 13px 110px}.hero{padding:21px}.hero h2{font-size:1.55rem}.path-node{max-width:100%}.node-btn{width:58px;height:58px}}


/* Gioco cromatico, ombre in rilievo e interazioni */
