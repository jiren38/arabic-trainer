function equipItem(type, val) {
  if (!St.d.equipped) St.d.equipped = {};
  St.d.equipped[type] = val;
  St.save();
  if (window.saveCloudProgress) window.saveCloudProgress();
  toast("✨ Avatar aggiornato!");
  render();
}

