function cloudAction(name){
  const action=window[name];
  if(typeof action!=="function"){
    toast("Per accedere e sincronizzare i dati, apri il sito dal suo indirizzo GitHub Pages.");
    return;
  }
  Promise.resolve().then(()=>action()).then(()=>render()).catch(error=>{
    console.error("Operazione account non riuscita:",error);
    toast("Accesso non riuscito. Controlla la connessione e riprova.");
  });
}
